{
  "name": "Smart Meeting Room Booking System",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bullseye",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Smart Room Web App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install && npx prisma db push --schema=prisma/schema.sqlite.prisma",
  "customizations": {
    "vscode": {
      "extensions": [
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
