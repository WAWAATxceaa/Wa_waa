// Alternative schema for standalone testing with SQLite (without needing PostgreSQL)
// To use SQLite: npx prisma db push --schema=prisma/schema.sqlite.prisma

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  department    String?
  role          String         @default("EMPLOYEE") // EMPLOYEE, ADMIN
  avatarUrl     String?
  bookings      Booking[]
  notifications Notification[]
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Room {
  id          String    @id @default(cuid())
  name        String    @unique
  capacity    Int
  floor       Int
  description String?
  amenities   String    @default("[]") // JSON stringified array for SQLite
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  imageUrl    String?
  color       String    @default("#3b82f6")
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id               String    @id @default(cuid())
  roomId           String
  room             Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  startTime        DateTime
  endTime          DateTime
  participantCount Int       @default(1)
  participantsNote String?
  status           String    @default("CONFIRMED") // CONFIRMED, CANCELLED
  cancelledReason  String?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // BOOKING_CONFIRMED, REMINDER_15MIN, etc.
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  createdAt DateTime @default(now())
}
