generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Room {
  id          String          @id @default(cuid())
  name        String
  code        String          @unique
  capacity    Int
  location    String
  color       String          @default("#4F46E5") // สีแถบปฏิทิน
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  equipments  RoomEquipment[]
  bookings    Booking[]
}

model Equipment {
  id          String             @id @default(cuid())
  name        String             @unique
  icon        String             @default("laptop") // projector, tv, video, mic, whiteboard
  description String?

  rooms       RoomEquipment[]
  bookings    BookingEquipment[]
}

model RoomEquipment {
  id          String    @id @default(cuid())
  roomId      String
  equipmentId String
  quantity    Int       @default(1)

  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([roomId, equipmentId])
}

model Booking {
  id               String             @id @default(cuid())
  bookingCode      String             @unique // e.g. BK-2610-A89B
  manageToken      String             @unique // Secret UUID สำหรับแก้ไข/ยกเลิก
  roomId           String
  bookerName       String
  bookerDepartment String
  bookerEmail      String
  bookerPhone      String
  title            String
  description      String?
  startTime        DateTime
  endTime          DateTime
  participantCount Int                @default(1)
  status           String             @default("CONFIRMED") // CONFIRMED, CANCELLED
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  room             Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  equipments       BookingEquipment[]

  @@index([roomId, startTime, endTime])
  @@index([bookingCode])
  @@index([manageToken])
}

model BookingEquipment {
  id          String    @id @default(cuid())
  bookingId   String
  equipmentId String
  quantity    Int       @default(1)
  note        String?

  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([bookingId, equipmentId])
}
